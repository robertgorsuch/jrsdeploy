<?xml version="1.0" encoding="UTF-8"?>
<!-- Harness fixture tile A (JR7-native). Deployed to STAGE /reports/_smoke/harness/tile_a for the recorded-server harness. -->
<jasperReport name="tile_a" language="java" pageWidth="400" pageHeight="300" columnWidth="360" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<query language="SQL"><![CDATA[
SELECT store_state, COUNT(*)::int AS store_count
FROM store
WHERE store_state IS NOT NULL
GROUP BY store_state
ORDER BY store_count DESC
	]]></query>
	<field name="store_state" class="java.lang.String"/>
	<field name="store_count" class="java.lang.Integer"/>
	<title height="30">
		<element kind="staticText" x="0" y="0" width="360" height="24" fontSize="14.0" bold="true" hTextAlign="Center"><text><![CDATA[Tile A: stores by state]]></text></element>
	</title>
	<detail>
		<band height="14">
			<element kind="textField" x="0" y="0" width="240" height="14" fontSize="9.0"><expression><![CDATA[$F{store_state}]]></expression></element>
			<element kind="textField" x="240" y="0" width="120" height="14" fontSize="9.0" hTextAlign="Right" pattern="#,##0"><expression><![CDATA[$F{store_count}]]></expression></element>
		</band>
	</detail>
</jasperReport>
