# Compiled / generated artifacts (regenerable)
*.class
*.jasper
__pycache__/

# Microsoft Office owner-lock temp files (created while a doc is open)
~$*

# Large regenerable data exports (rebuild from the DB)
output/

# Dashboard compose / resource export zips (regenerated by the jasper-deploy
# compose/export scripts and the wizard)
report/**/dashboard_model.zip
report/**/*_export.zip

# Report-verification PDFs (re-run reports to regenerate)
out_verify/
out/

# Vendor docs: full JasperReports Server 10.0.0 PDF set (~62 MB, machine-local,
# freely re-downloadable from Jaspersoft). Referenced by the jasper-deploy skill
# but kept out of the repo like the jasperreports-lib jars.
docs/

# jasper-wizard webapp build artifacts (regenerated by build.ps1)
webapp/jasper-wizard/build/
webapp/jasper-wizard/target/
webapp/jasper-wizard/work/

# Secrets — service-account keys / credentials (must never be committed)
sa.json
*.sa.json
*-sa.json

# --- Out of public-repo scope (local-only tooling; repo is Jaspersoft-focused) ---
# Actian Avalanche skill + POS data-loading utilities (not Jaspersoft)
.claude/skills/admiral/
.claude/worktrees/
/*.java
/load*.sql
/create_pos_transactions.sql
/pos_sample*.csv

# Internal collateral (product-design specs, PM decks, sales plays, UI mockups)
# -- authored here for convenience but not part of the public skill repo
/JasperReports_Server_*PDS*
/JasperReports_Server_*PM_Overview*
/JasperReports_Server_*Product_Design_Specification*
/SALES_PLAY_*
ui_mockups/

# Geocoder-heritage generated map outputs (Leaflet HTML, ~23 MB, regenerable)
maps/

# Report run artifacts (regenerate by running the reports via the skill;
# report/data/ CSV adapter sources stay tracked)
report/**/*.pdf
report/foodmart/*.png
report/foodmart/*.csv
backups/

# Load / job logs (regenerated on each run)
*.log

# Generated Office artifacts (DOCX/PPTX renders of tracked md/html sources;
# regenerate with make_docx.ps1 - binary blobs stay out of the public repo)
*.docx
*.pptx

# Notes:
#  - The JasperReports runtime jar dir (JR_LIB_DIR) and 7.0.6 source tree
#    live outside this repo by design.
#  - TIGER staging data lives in C:\gisdata (not tracked).

# Runtime lock artifacts
.in_use/

# Local Claude Code project config (settings, skill junction/copy) - never ship
.claude/

# Release archives built locally (attached to GitHub releases, not tracked)
*.zip

# Wobby API credentials (public repo - never commit)
wobby.config.json

# Model binaries live in the warehouse MLflow registry, not in git.
# They are large, and a pickle is an execution vector in a public repo.
scripts/pos_perf/*.joblib
