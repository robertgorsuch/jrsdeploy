<?xml version="1.0" encoding="UTF-8"?>
<!-- Operations Console: 5-up KPI strip (Net Sales / Transactions / Quantity /
     Avg Basket / Stores), filtered by the shared p_from/p_to/p_regions/p_promo/
     p_period controls. Layout pattern mirrors exec_kpi_strip.jrxml (divider
     lines, evaluationTime="Report"). JR7-native.

     CRITICAL: transaction-count basis. dash_monthly.tx is COUNT(DISTINCT
     transactionuniqueid) computed PER (yr,mo,storeregion,promotiontype,
     pandemic_period) group. Summing dash_monthly.tx across promotiontype
     double-counts any transaction whose line items span more than one
     promotiontype in a month (confirmed ~44% overcount in Task 3: SUM =
     28,035,086 vs the true 19,487,389). So when p_promo = 'All' (no single
     promotiontype selected), tx CANNOT be derived from dash_monthly at all.
     This report is therefore the ONE dashlet in the Operations Console allowed
     to query the base table pos_sales_detail directly - subquery "t" below
     computes tx as COUNT(DISTINCT transactionuniqueid) straight from the base
     table under the same date/region/promo/period filters (promo/period are
     re-derived inline since pos_sales_detail carries neither dash_monthly's
     normalized promotiontype nor its pandemic_period column). Sales/qty/stores
     (subqueries "m" and "s") stay on the aggregate tables - those measures are
     truly additive regardless of grouping granularity, so summing them is safe
     and fast. Avg Basket = m.sales_ext / t.tx, using the correct tx. -->
<jasperReport name="ops_kpi_chips" language="java" pageWidth="1600" pageHeight="130" columnWidth="1580" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10">
	<parameter name="p_from" class="java.util.Date">
		<defaultValueExpression><![CDATA[new java.text.SimpleDateFormat("yyyy-MM-dd").parse("2019-01-01")]]></defaultValueExpression>
	</parameter>
	<parameter name="p_to" class="java.util.Date">
		<defaultValueExpression><![CDATA[new java.text.SimpleDateFormat("yyyy-MM-dd").parse("2020-12-31")]]></defaultValueExpression>
	</parameter>
	<parameter name="p_regions" class="java.util.Collection"/>
	<parameter name="p_promo" class="java.lang.String">
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_period" class="java.lang.String">
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>

	<query language="SQL"><![CDATA[
SELECT m.sales_ext AS sales_ext, m.qty AS qty, t.tx AS tx,
       m.sales_ext / NULLIF(t.tx,0) AS basket, s.stores AS stores
FROM
  (SELECT SUM(sales_ext) AS sales_ext, SUM(qty) AS qty
   FROM dash_monthly
   WHERE (yr*100+mo) BETWEEN YEAR($P{p_from})*100+MONTH($P{p_from}) AND YEAR($P{p_to})*100+MONTH($P{p_to})
     AND $X{IN, storeregion, p_regions}
     AND ($P{p_promo} = 'All' OR ($P{p_promo} = 'NONE' AND promotiontype = '') OR promotiontype = $P{p_promo})
     AND ($P{p_period} = 'All' OR pandemic_period = $P{p_period})
  ) m,
  (SELECT COUNT(DISTINCT transactionuniqueid) AS tx
   FROM pos_sales_detail
   WHERE transactiontype = 'Regular Sale'
     AND (YEAR(DATE(saledate))*100+MONTH(DATE(saledate))) BETWEEN YEAR($P{p_from})*100+MONTH($P{p_from}) AND YEAR($P{p_to})*100+MONTH($P{p_to})
     AND $X{IN, storeregion, p_regions}
     AND ($P{p_promo} = 'All' OR ($P{p_promo} = 'NONE' AND TRIM(COALESCE(promotiontype,'')) = '') OR TRIM(COALESCE(promotiontype,'')) = $P{p_promo})
     AND ($P{p_period} = 'All' OR (CASE WHEN DATE(saledate) >= DATE('2020-03-01') THEN 'Pandemic' ELSE 'Pre-pandemic' END) = $P{p_period})
  ) t,
  (SELECT SUM(stores) AS stores FROM dash_region WHERE $X{IN, storeregion, p_regions}) s
	]]></query>

	<field name="sales_ext" class="java.math.BigDecimal"/>
	<field name="qty" class="java.lang.Long"/>
	<field name="tx" class="java.lang.Long"/>
	<field name="basket" class="java.math.BigDecimal"/>
	<field name="stores" class="java.lang.Long"/>

	<title height="110">
		<element kind="staticText" x="0" y="14" width="316" height="26" fontSize="13.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Net Sales]]></text></element>
		<element kind="textField" x="0" y="44" width="316" height="50" fontSize="26.0" bold="true" forecolor="#1F4E79" hTextAlign="Center" vTextAlign="Middle" pattern="$#,##0" evaluationTime="Report"><expression><![CDATA[$F{sales_ext}]]></expression></element>

		<element kind="line" x="316" y="20" width="1" height="70" forecolor="#D6E0EF"/>
		<element kind="staticText" x="316" y="14" width="316" height="26" fontSize="13.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Transactions]]></text></element>
		<element kind="textField" x="316" y="44" width="316" height="50" fontSize="26.0" bold="true" forecolor="#1F4E79" hTextAlign="Center" vTextAlign="Middle" pattern="#,##0" evaluationTime="Report"><expression><![CDATA[$F{tx}]]></expression></element>

		<element kind="line" x="632" y="20" width="1" height="70" forecolor="#D6E0EF"/>
		<element kind="staticText" x="632" y="14" width="316" height="26" fontSize="13.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Quantity Sold]]></text></element>
		<element kind="textField" x="632" y="44" width="316" height="50" fontSize="26.0" bold="true" forecolor="#1F4E79" hTextAlign="Center" vTextAlign="Middle" pattern="#,##0" evaluationTime="Report"><expression><![CDATA[$F{qty}]]></expression></element>

		<element kind="line" x="948" y="20" width="1" height="70" forecolor="#D6E0EF"/>
		<element kind="staticText" x="948" y="14" width="316" height="26" fontSize="13.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Avg Basket]]></text></element>
		<element kind="textField" x="948" y="44" width="316" height="50" fontSize="26.0" bold="true" forecolor="#1F4E79" hTextAlign="Center" vTextAlign="Middle" pattern="$#,##0.00" evaluationTime="Report"><expression><![CDATA[$F{basket}]]></expression></element>

		<element kind="line" x="1264" y="20" width="1" height="70" forecolor="#D6E0EF"/>
		<element kind="staticText" x="1264" y="14" width="316" height="26" fontSize="13.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Stores]]></text></element>
		<element kind="textField" x="1264" y="44" width="316" height="50" fontSize="26.0" bold="true" forecolor="#1F4E79" hTextAlign="Center" vTextAlign="Middle" pattern="#,##0" evaluationTime="Report"><expression><![CDATA[$F{stores}]]></expression></element>
	</title>

</jasperReport>
