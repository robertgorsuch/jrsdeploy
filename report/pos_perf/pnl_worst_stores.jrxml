<?xml version="1.0" encoding="UTF-8"?>
<!-- Store Profit and Budget cockpit: the six trading stores with the lowest
     four-wall margin in 2020. Ranked-table pattern mirrors exec_top_stores.jrxml
     ($V{REPORT_COUNT} rank column, #1F4E79 header band, #D6E0EF row dividers).

     The store-name cell carries a JR7 drill-down: linkType="ReportExecution"
     linkTarget="Blank" plus repeated <hyperlinkParameter name="..."> children
     each holding an <expression> (the JR7 flattened form - the JR6
     <hyperlinkParameterExpression> child is NOT used). Parameters: _report
     (the target store P&L statement), p_store, p_yyyymm. The target report is
     built by a later task, so until then the click-through 404s; that is
     expected and does not affect this tile's rendering. -->
<jasperReport name="pnl_worst_stores" language="java" pageWidth="800" pageHeight="440" columnWidth="780" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10">

	<query language="SQL"><![CDATA[
SELECT FIRST 6 storenumber, storename, store_format, region,
       DECIMAL(100.0 * FLOAT8(SUM(four_wall_ebitda)) / FLOAT8(NULLIF(SUM(net_sales), 0)), 6, 2) AS fw_margin_pct,
       DECIMAL(SUM(net_sales), 14, 2) AS net_sales
FROM store_pnl_monthly WHERE yr = 2020 AND trading_status = 'Trading'
GROUP BY storenumber, storename, store_format, region ORDER BY fw_margin_pct ASC
	]]></query>

	<field name="storenumber" class="java.lang.Integer"/>
	<field name="storename" class="java.lang.String"/>
	<field name="store_format" class="java.lang.String"/>
	<field name="region" class="java.lang.String"/>
	<field name="fw_margin_pct" class="java.math.BigDecimal"/>
	<field name="net_sales" class="java.math.BigDecimal"/>

	<title height="52">
		<element kind="image" x="0" y="0" width="44" height="44" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Top"><expression><![CDATA["repo:/images/actian_logo"]]></expression></element>
		<element kind="staticText" x="0" y="0" width="780" height="24" fontSize="16.0" bold="true" forecolor="#1F4E79" hTextAlign="Center"><text><![CDATA[Lowest Four-Wall Margin, 2020]]></text></element>
		<element kind="staticText" x="0" y="26" width="780" height="14" fontSize="9.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Trading stores ranked by four-wall margin -- click a store name for its full statement]]></text></element>
	</title>

	<columnHeader height="22">
		<element kind="rectangle" x="0" y="0" width="780" height="22" mode="Opaque" backcolor="#1F4E79" forecolor="#1F4E79"/>
		<element kind="staticText" x="6" y="0" width="28" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[#]]></text></element>
		<element kind="staticText" x="38" y="0" width="250" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" vTextAlign="Middle"><text><![CDATA[Store]]></text></element>
		<element kind="staticText" x="292" y="0" width="130" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" vTextAlign="Middle"><text><![CDATA[Format]]></text></element>
		<element kind="staticText" x="426" y="0" width="100" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" vTextAlign="Middle"><text><![CDATA[Region]]></text></element>
		<element kind="staticText" x="530" y="0" width="120" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Net Sales]]></text></element>
		<element kind="staticText" x="654" y="0" width="120" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Four-wall %]]></text></element>
	</columnHeader>

	<detail>
		<band height="24">
			<element kind="textField" x="6" y="0" width="28" height="20" fontSize="10.0" bold="true" forecolor="#1F4E79" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$V{REPORT_COUNT}]]></expression></element>
			<element kind="textField" x="38" y="0" width="250" height="20" fontSize="10.0" vTextAlign="Middle" forecolor="#0550DC" linkType="ReportExecution" linkTarget="Blank">
				<expression><![CDATA[$F{storename}]]></expression>
				<hyperlinkParameter name="_report"><expression><![CDATA["/reports/pos_perf/rpt_store_pnl_statement"]]></expression></hyperlinkParameter>
				<hyperlinkParameter name="p_store"><expression><![CDATA[$F{storenumber}]]></expression></hyperlinkParameter>
				<hyperlinkParameter name="p_yyyymm"><expression><![CDATA["202012"]]></expression></hyperlinkParameter>
			</element>
			<element kind="textField" x="292" y="0" width="130" height="20" fontSize="10.0" vTextAlign="Middle"><expression><![CDATA[$F{store_format}]]></expression></element>
			<element kind="textField" x="426" y="0" width="100" height="20" fontSize="10.0" vTextAlign="Middle"><expression><![CDATA[$F{region}]]></expression></element>
			<element kind="textField" x="530" y="0" width="120" height="20" fontSize="10.0" hTextAlign="Right" vTextAlign="Middle" pattern="$#,##0"><expression><![CDATA[$F{net_sales}]]></expression></element>
			<element kind="textField" x="654" y="0" width="120" height="20" fontSize="10.0" bold="true" forecolor="#D9534F" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.0'%'"><expression><![CDATA[$F{fw_margin_pct}]]></expression></element>
			<element kind="line" x="0" y="23" width="780" height="1" forecolor="#D6E0EF"/>
		</band>
	</detail>

</jasperReport>
