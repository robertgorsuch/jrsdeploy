<?xml version="1.0" encoding="UTF-8"?>
<!-- Retention and Churn console: the retention actions the model recommends,
     with how many customers each one covers and how much expected lifetime
     value sits behind it, ranked by value at risk. Rows whose recommended
     action is "None" are excluded: an action row with no action in it is not
     something anyone can work, and leaving it in would put the largest bar on
     the tile against a non decision.

     List tile pattern from pnl_worst_stores.jrxml: a #1F4E79 header band with
     white labels, a 24pt detail row, and a #D6E0EF zebra rectangle gated on
     $V{REPORT_COUNT} % 2 so alternating rows are shaded.

     THE DRILL IS FIXED SCOPE, NOT ROW SCOPE. Every row's Action cell carries a
     JR7 ReportExecution hyperlink into the Churn Action List, using the
     flattened <hyperlinkParameter name="..."><expression> form (the JR6
     <hyperlinkParameterExpression> child is NOT used). It passes p_region as
     the LITERAL string "All", not the console's region selection, and
     p_score_date as the console's score date. That is the same convention
     Phase 1 used for trs_tax_province to rpt_tax_remittance: the target is a
     workable ranked list of at risk customers, not a per action drill, so it
     always opens on the full region scope rather than inheriting a filter the
     reader would then have to undo. p_region and p_score_date are the exact two
     parameter names the target report declares, both Strings.

     The filter contract, and why the parameters are named after the live input
     controls rather than after the task brief's p_tiers/p_bands, is documented
     at length in chn_kpi.jrxml. -->
<jasperReport name="chn_actions" language="java" pageWidth="800" pageHeight="380" columnWidth="780" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10">
	<parameter name="chn_score_date" class="java.util.Collection"/>
	<parameter name="p_regions" class="java.util.Collection"/>
	<parameter name="chn_tier" class="java.util.Collection"/>
	<parameter name="chn_band" class="java.util.Collection"/>
	<parameter name="p_score_date" class="java.lang.String">
		<defaultValueExpression><![CDATA[($P{chn_score_date} == null || $P{chn_score_date}.isEmpty()) ? "2020-12-31" : String.valueOf($P{chn_score_date}.iterator().next())]]></defaultValueExpression>
	</parameter>

	<query language="SQL"><![CDATA[
SELECT recommended_action,
       COUNT(*) AS customers,
       DECIMAL(SUM(expected_ltv_at_risk), 14, 2) AS ltv_at_risk
FROM dash_churn
WHERE score_date = DATE($P{p_score_date})
  AND recommended_action <> 'None'
  AND ($X{IN, region, p_regions})
  AND ($X{IN, loyalty_tier, chn_tier})
  AND ($X{IN, risk_band, chn_band})
GROUP BY recommended_action
ORDER BY ltv_at_risk DESC
	]]></query>

	<field name="recommended_action" class="java.lang.String"/>
	<field name="customers" class="java.lang.Long"/>
	<field name="ltv_at_risk" class="java.math.BigDecimal"/>

	<title height="52">
		<element kind="image" x="0" y="0" width="44" height="44" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Top"><expression><![CDATA["repo:/images/actian_logo"]]></expression></element>
		<element kind="staticText" x="0" y="0" width="780" height="24" fontSize="16.0" bold="true" forecolor="#1F4E79" hTextAlign="Center"><text><![CDATA[Recommended Actions]]></text></element>
		<element kind="staticText" x="0" y="26" width="780" height="14" fontSize="9.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Customers and LTV at risk by action, ranked. Click an action for the full customer list.]]></text></element>
	</title>

	<columnHeader height="22">
		<element kind="rectangle" x="0" y="0" width="780" height="22" mode="Opaque" backcolor="#1F4E79" forecolor="#1F4E79"/>
		<element kind="staticText" x="6" y="0" width="320" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" vTextAlign="Middle"><text><![CDATA[Action]]></text></element>
		<element kind="staticText" x="336" y="0" width="180" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Customers]]></text></element>
		<element kind="staticText" x="526" y="0" width="248" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[LTV at Risk]]></text></element>
	</columnHeader>

	<detail>
		<band height="24">
			<element kind="rectangle" x="0" y="0" width="780" height="24" mode="Opaque" backcolor="#D6E0EF" forecolor="#D6E0EF">
				<printWhenExpression><![CDATA[$V{REPORT_COUNT}.intValue() % 2 == 0]]></printWhenExpression>
			</element>
			<element kind="textField" x="6" y="0" width="320" height="24" fontSize="10.0" vTextAlign="Middle" forecolor="#0550DC" linkType="ReportExecution" linkTarget="Blank">
				<expression><![CDATA[$F{recommended_action}]]></expression>
				<hyperlinkParameter name="_report"><expression><![CDATA["/reports/pos_perf/rpt_churn_action_list"]]></expression></hyperlinkParameter>
				<hyperlinkParameter name="p_region"><expression><![CDATA["All"]]></expression></hyperlinkParameter>
				<hyperlinkParameter name="p_score_date"><expression><![CDATA[$P{p_score_date}]]></expression></hyperlinkParameter>
			</element>
			<element kind="textField" x="336" y="0" width="180" height="24" fontSize="10.0" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0" blankWhenNull="true"><expression><![CDATA[$F{customers}]]></expression></element>
			<element kind="textField" x="526" y="0" width="248" height="24" fontSize="10.0" bold="true" forecolor="#1F4E79" hTextAlign="Right" vTextAlign="Middle" pattern="$#,##0" blankWhenNull="true"><expression><![CDATA[$F{ltv_at_risk}]]></expression></element>
			<element kind="line" x="0" y="23" width="780" height="1" forecolor="#D6E0EF"/>
		</band>
	</detail>

</jasperReport>
