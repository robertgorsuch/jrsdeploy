<?xml version="1.0" encoding="UTF-8"?>
<!-- Store Profit and Budget cockpit: four-wall EBITDA variance against the
     original 2020 budget, by region. Diverging bars: TWO series over the same
     category, each returning BigDecimal.ZERO unless the variance has the
     matching sign, so the bar colour encodes favourable (brand blue) vs
     unfavourable (teal) without a conditional-style customizer.
     JR7-native bar plot (showTickMarks/showTickLabels/showLabels per
     jr7-valid-elements.md 3c); chart is in the title band, so
     evaluationTime="Report".

     POST-COMPLETION FIX (seriesColor null-registration): the query orders
     regions by variance DESC, so the first row is whichever region has the
     largest signed variance. If every region is unfavourable that period,
     the first row is negative and the old null-valued "Favourable" series
     never registers at row 0 - "Unfavourable" registers first instead and
     steals seriesColor order="0" (brand blue), inverting both bars. This is
     the same JR7 category-dataset defect documented in commit 1e068ec
     (rpt_store_pnl_statement.jrxml): a null value is not registered: a zero
     is. Both series now return BigDecimal.ZERO for the non-matching sign
     instead of null, so both always register at row 0 in declaration order
     regardless of how the data sorts, and the non-matching bar draws at
     zero height (invisible) rather than being omitted. -->
<jasperReport name="pnl_variance_region" language="java" pageWidth="800" pageHeight="440" columnWidth="780" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10">

	<query language="SQL"><![CDATA[
SELECT region, DECIMAL(SUM(actual_four_wall_ebitda) - SUM(budget_four_wall_ebitda), 14, 2) AS variance_cad
FROM store_budget_vs_actual WHERE yr = 2020 AND budget_version = 'Original'
GROUP BY region ORDER BY 2 DESC
	]]></query>

	<field name="region" class="java.lang.String"/>
	<field name="variance_cad" class="java.math.BigDecimal"/>

	<title height="420">
		<element kind="image" x="0" y="0" width="44" height="44" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Top"><expression><![CDATA["repo:/images/actian_logo"]]></expression></element>
		<element kind="staticText" x="0" y="0" width="780" height="24" fontSize="16.0" bold="true" forecolor="#1F4E79" hTextAlign="Center"><text><![CDATA[Four-wall EBITDA vs Original budget by region, 2020 (CAD)]]></text></element>
		<element kind="staticText" x="0" y="26" width="780" height="14" fontSize="9.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Favourable variance in brand blue, unfavourable in teal]]></text></element>

		<element kind="chart" chartType="bar" x="0" y="52" width="780" height="368" evaluationTime="Report">
			<dataset kind="category">
				<series>
					<seriesExpression><![CDATA["Favourable"]]></seriesExpression>
					<categoryExpression><![CDATA[$F{region}]]></categoryExpression>
					<valueExpression><![CDATA[$F{variance_cad} != null && $F{variance_cad}.signum() >= 0 ? $F{variance_cad} : java.math.BigDecimal.ZERO]]></valueExpression>
				</series>
				<series>
					<seriesExpression><![CDATA["Unfavourable"]]></seriesExpression>
					<categoryExpression><![CDATA[$F{region}]]></categoryExpression>
					<valueExpression><![CDATA[$F{variance_cad} != null && $F{variance_cad}.signum() < 0 ? $F{variance_cad} : java.math.BigDecimal.ZERO]]></valueExpression>
				</series>
			</dataset>
			<plot showTickMarks="true" showTickLabels="true" showLabels="true">
				<seriesColor order="0" color="#0550DC"/>
				<seriesColor order="1" color="#239CA8"/>
			</plot>
		</element>
	</title>

</jasperReport>
