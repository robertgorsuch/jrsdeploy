<?xml version="1.0" encoding="UTF-8"?>
<!-- Executive Overview: Top 6 stores by net sales. Ranked table pattern mirrors
     foodmart/top_5_products.jrxml ($V{REPORT_COUNT} rank column, header band,
     divider lines). JR7-native.

     NAVY THEME: full-bleed #000032 background band with margins folded into the
     element coordinates (see exec_kpi_strip.jrxml). The header band becomes the
     tile-border navy #26305A and the row rules #26305A. The detail cells had NO
     forecolor in the light build (they inherited JR's default black, which was
     legible on the white page); on navy they need an explicit #FFFFFF, so it is
     added here rather than remapped. The plan's "zebra #D6E0EF becomes #0B1230"
     has no counterpart - this table never had zebra banding, only the #D6E0EF
     row rule, which the plan's own forecolor mapping turns into #26305A - so no
     banding rectangle is invented. -->
<jasperReport name="exec_top_stores" language="java" pageWidth="800" pageHeight="214" columnWidth="800" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<query language="SQL"><![CDATA[
SELECT storename, storeregion, sales_ext FROM dash_store ORDER BY sales_ext DESC FETCH FIRST 6 ROWS ONLY
	]]></query>

	<field name="storename" class="java.lang.String"/>
	<field name="storeregion" class="java.lang.String"/>
	<field name="sales_ext" class="java.math.BigDecimal"/>

	<background height="214">
		<element kind="rectangle" x="0" y="0" width="800" height="214" mode="Opaque" backcolor="#000032" forecolor="#000032"/>
	</background>

	<title height="62">
		<element kind="image" x="10" y="10" width="44" height="44" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Top"><expression><![CDATA["repo:/images/actian_logo"]]></expression></element>
		<element kind="staticText" x="10" y="10" width="780" height="24" fontSize="16.0" bold="true" forecolor="#FFFFFF" hTextAlign="Center"><text><![CDATA[Top 6 Stores by Net Sales]]></text></element>
		<element kind="staticText" x="10" y="36" width="780" height="14" fontSize="9.0" forecolor="#8AC6F8" hTextAlign="Center"><text><![CDATA[Highest-performing store locations]]></text></element>
	</title>

	<columnHeader height="22">
		<element kind="rectangle" x="10" y="0" width="780" height="22" mode="Opaque" backcolor="#26305A" forecolor="#26305A"/>
		<element kind="staticText" x="16" y="0" width="34" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[#]]></text></element>
		<element kind="staticText" x="56" y="0" width="330" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" vTextAlign="Middle"><text><![CDATA[Store]]></text></element>
		<element kind="staticText" x="390" y="0" width="200" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" vTextAlign="Middle"><text><![CDATA[Region]]></text></element>
		<element kind="staticText" x="596" y="0" width="188" height="22" fontSize="10.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Net Sales]]></text></element>
	</columnHeader>

	<detail>
		<band height="24">
			<element kind="textField" x="16" y="0" width="34" height="20" fontSize="10.0" bold="true" forecolor="#FFFFFF" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$V{REPORT_COUNT}]]></expression></element>
			<element kind="textField" x="56" y="0" width="330" height="20" fontSize="10.0" forecolor="#FFFFFF" vTextAlign="Middle"><expression><![CDATA[$F{storename}]]></expression></element>
			<element kind="textField" x="390" y="0" width="200" height="20" fontSize="10.0" forecolor="#FFFFFF" vTextAlign="Middle"><expression><![CDATA[$F{storeregion}]]></expression></element>
			<element kind="textField" x="596" y="0" width="188" height="20" fontSize="10.0" forecolor="#FFFFFF" hTextAlign="Right" vTextAlign="Middle" pattern="$#,##0"><expression><![CDATA[$F{sales_ext}]]></expression></element>
			<element kind="line" x="10" y="23" width="780" height="1" forecolor="#26305A"/>
		</band>
	</detail>

</jasperReport>
