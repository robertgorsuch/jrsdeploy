<?xml version="1.0" encoding="UTF-8"?>
<!-- Retention and Churn console: scored customers by risk band, worst first.
     Four categories, single series, legend off. The bands are ordered by an
     explicit CASE rank rather than alphabetically so the tile reads Critical,
     High, Watch, Low from the top down; JR7 preserves the query's row order in
     a category dataset unless a comparator overrides it, and the sibling
     trs_tax_province tile confirmed on rasterized output that a horizontal
     category plot renders the first row at the top.

     One series, so the bar colour is a constant: every band on this tile counts
     customers who carry churn risk, so the unfavourable red is used throughout
     and Critical earns its emphasis from bar length, not from hue. The value is
     still zero guarded, per the console rule that a null on the first row fails
     to register a series and shifts the seriesColor order bindings.

     JR7 native bar plot (showTickMarks/showTickLabels per jr7-valid-elements.md
     3c). The chart lives in the title band, so evaluationTime="Report".

     The filter contract, and why the parameters are named after the live input
     controls rather than after the task brief's p_tiers/p_bands, is documented
     at length in chn_kpi.jrxml. -->
<jasperReport name="chn_bands" language="java" pageWidth="600" pageHeight="420" columnWidth="580" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10">
	<parameter name="chn_score_date" class="java.util.Collection"/>
	<parameter name="p_regions" class="java.util.Collection"/>
	<parameter name="chn_tier" class="java.util.Collection"/>
	<parameter name="chn_band" class="java.util.Collection"/>
	<parameter name="p_score_date" class="java.lang.String">
		<defaultValueExpression><![CDATA[($P{chn_score_date} == null || $P{chn_score_date}.isEmpty()) ? "2020-12-31" : String.valueOf($P{chn_score_date}.iterator().next())]]></defaultValueExpression>
	</parameter>

	<query language="SQL"><![CDATA[
SELECT risk_band,
       CASE risk_band WHEN 'Critical' THEN 1 WHEN 'High' THEN 2 WHEN 'Watch' THEN 3 ELSE 4 END AS band_order,
       COUNT(*) AS customers
FROM dash_churn
WHERE score_date = DATE($P{p_score_date})
  AND ($X{IN, region, p_regions})
  AND ($X{IN, loyalty_tier, chn_tier})
  AND ($X{IN, risk_band, chn_band})
GROUP BY risk_band
ORDER BY band_order
	]]></query>

	<field name="risk_band" class="java.lang.String"/>
	<field name="band_order" class="java.lang.Integer"/>
	<field name="customers" class="java.lang.Long"/>

	<title height="400">
		<element kind="image" x="0" y="0" width="44" height="44" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Top"><expression><![CDATA["repo:/images/actian_logo"]]></expression></element>
		<element kind="staticText" x="0" y="2" width="580" height="22" fontSize="16.0" bold="true" forecolor="#1F4E79" hTextAlign="Center"><text><![CDATA[Customers by Risk Band]]></text></element>
		<element kind="textField" x="0" y="26" width="580" height="14" fontSize="9.0" forecolor="#5B7DA6" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA["Score date " + $P{p_score_date}]]></expression></element>

		<element kind="chart" chartType="bar" x="0" y="48" width="580" height="352" showLegend="false" evaluationTime="Report">
			<dataset kind="category">
				<series>
					<seriesExpression><![CDATA["Customers"]]></seriesExpression>
					<categoryExpression><![CDATA[$F{risk_band} == null ? "Unclassified" : $F{risk_band}]]></categoryExpression>
					<valueExpression><![CDATA[$F{customers} == null ? Long.valueOf(0) : $F{customers}]]></valueExpression>
				</series>
			</dataset>
			<plot orientation="Horizontal" showTickMarks="true" showTickLabels="true">
				<seriesColor order="0" color="#D9534F"/>
			</plot>
		</element>
	</title>

</jasperReport>
