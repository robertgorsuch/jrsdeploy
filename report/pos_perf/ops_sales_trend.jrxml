<?xml version="1.0" encoding="UTF-8"?>
<!-- Operations Console: monthly Net Sales trend, filtered by the shared
     p_from/p_to/p_regions/p_promo/p_period controls. Pattern mirrors
     exec_trend.jrxml (line chart, showLines/showShapes,
     categoryAxisTickLabelRotation="-45"; category label built in Java, not
     SQL lpad, to avoid a Postgres-dialect function on Ingres/Avalanche).
     Additive measure (SUM(sales_ext)) grouped by yr,mo - no transaction-count
     double-count risk here (see ops_kpi_chips.jrxml for that ruling). -->
<jasperReport name="ops_sales_trend" language="java" pageWidth="1000" pageHeight="220" columnWidth="980" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10">
	<parameter name="p_from" class="java.util.Date">
		<defaultValueExpression><![CDATA[new java.text.SimpleDateFormat("yyyy-MM-dd").parse("2019-01-01")]]></defaultValueExpression>
	</parameter>
	<parameter name="p_to" class="java.util.Date">
		<defaultValueExpression><![CDATA[new java.text.SimpleDateFormat("yyyy-MM-dd").parse("2020-12-31")]]></defaultValueExpression>
	</parameter>
	<parameter name="p_regions" class="java.util.Collection"/>
	<parameter name="p_promo" class="java.lang.String">
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_period" class="java.lang.String">
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>

	<query language="SQL"><![CDATA[
SELECT yr, mo, SUM(sales_ext) AS v
FROM dash_monthly
WHERE (yr*100+mo) BETWEEN YEAR($P{p_from})*100+MONTH($P{p_from}) AND YEAR($P{p_to})*100+MONTH($P{p_to})
  AND $X{IN, storeregion, p_regions}
  AND ($P{p_promo} = 'All' OR ($P{p_promo} = 'NONE' AND promotiontype = '') OR promotiontype = $P{p_promo})
  AND ($P{p_period} = 'All' OR pandemic_period = $P{p_period})
GROUP BY 1,2 ORDER BY 1,2
	]]></query>

	<field name="yr" class="java.lang.Integer"/>
	<field name="mo" class="java.lang.Integer"/>
	<field name="v" class="java.math.BigDecimal"/>

	<title height="40">
		<element kind="image" x="0" y="0" width="36" height="36" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Top"><expression><![CDATA["repo:/images/actian_logo"]]></expression></element>
		<element kind="staticText" x="0" y="0" width="980" height="22" fontSize="14.0" bold="true" forecolor="#1F4E79" hTextAlign="Center"><text><![CDATA[Net Sales Trend]]></text></element>
		<element kind="staticText" x="0" y="23" width="980" height="12" fontSize="8.0" forecolor="#5B7DA6" hTextAlign="Center"><text><![CDATA[Monthly net sales for the selected date range, region, promotion, and period]]></text></element>
	</title>

	<summary height="160">
		<element kind="chart" chartType="line" x="0" y="0" width="980" height="160" evaluationTime="Report">
			<dataset kind="category">
				<series>
					<seriesExpression><![CDATA["Net Sales"]]></seriesExpression>
					<categoryExpression><![CDATA[$F{yr} + "-" + ($F{mo} < 10 ? "0" + $F{mo} : "" + $F{mo})]]></categoryExpression>
					<valueExpression><![CDATA[$F{v}]]></valueExpression>
				</series>
			</dataset>
			<plot showLines="true" showShapes="true" categoryAxisTickLabelRotation="-45">
				<seriesColor order="0" color="#0550DC"/>
			</plot>
		</element>
	</summary>

</jasperReport>
